#!/bin/bash
set -euo pipefail

[[ -n "${DEBUG:-}" ]] && set -xv

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

screencapture -tjpg -i /tmp/pony.jpg

if [[ -e /tmp/pony.jpg ]]; then
  /usr/bin/ruby $DIR/tumblr-pony /tmp/pony.jpg
else
  echo "No screenshot found to upload"
  exit 1
fi
